<% layout("./layouts/boilerplate.ejs") %>

<div class="row mt-3">
    <h3 class="offset-3" style="color:#ff385c ;">SignUp on Dwellr</h3>
    <div class=" col-6 mt-3 offset-3">
        <form action="/signup" method="post" class="needs-validation" novalidate >
            <div class="mb-3">
            <label for="username" class="form-label">Username</label>
               <input type="text" name="username" id="username" class="form-control" required>
               <div class="invalid-feedback">Add some username</div>
            </div>
            <div class="mb-3">
            <label for="password" class="form-label">Password</label>
               <input type="password" name="password" id="password" class="form-control" required>
               <div class="invalid-feedback">Add some password</div>
            </div>
            <div class="mb-3">
            <label for="email" class="form-label">Email</label>
               <input type="email" name="email" id="email" class="form-control" required>
               <div class="invalid-feedback">Add some email</div>
            </div>
            
            <div class="offset-3 d-grid col-6">
                <button class="btn btn-success">SignUp</button>
            </div>
        </form>
    </div>
</div>