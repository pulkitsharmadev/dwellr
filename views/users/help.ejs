<%- layout("/layouts/boilerplate.ejs") %>
<div class="help-page">

    <div class="help-header">
        <h1>How can we help?</h1>
        <p>Find answers to common questions about Dwellr.</p>
    </div>

    <div class="help-content">
        <article class="help-card">
            <h3>How do I create a listing?</h3>
            <p>
                Log in to your account and click on
                <b>Become a host</b> to create a new listing.
            </p>
        </article>
    
        <article class="help-card">
            <h3>How do I edit my listing?</h3>
            <p>
                Open your listing and click the
                <b>Edit</b> button to update its information.
            </p>
        </article>
        
        <article class="help-card">
            <h3>How do I delete my listing?</h3>
            <p>
                Open your listing and use the
                <b>Delete</b> button.
            </p>
        </article>

        <article class="help-card">
            <h3>How do I leave a review?</h3>
            <p>
                Open a listing, scroll to the review section,
                select a rating, write your comment and click Submit.
            </p>
        </article>

        <article class="help-card">
            <h3>How do I log out?</h3>
            <p>
                Open the profile menu and select
                <b>Log out</b>.
            </p>
        </article>

    </div>

</div>