<% layout("./layouts/boilerplate.ejs") %>

<main class="company-details mx-auto my-5" style="max-width: 50rem;">
	<header class="mb-5">
		<p class="text-uppercase text-muted small fw-semibold mb-2">About Dwellr</p>
		<h1 class="mb-3">Company Details</h1>
		<p class="lead text-muted mb-0">
			Dwellr is a stay and hosting platform that helps guests discover places to stay
			and helps hosts share unique properties with travelers.
		</p>
	</header>

	<section class="mb-4">
		<h2 class="h4">About Dwellr</h2>
		<p>
			Dwellr brings property discovery, listing management, and guest-host connections
			together in one straightforward platform.
		</p>
	</section>

	<section class="mb-4">
		<h2 class="h4">What We Do</h2>
		<ul>
			<li>Help guests explore available stays and compare listing details.</li>
			<li>Give hosts tools to publish and manage property listings.</li>
			<li>Support communication and trust between guests and hosts.</li>
		</ul>
	</section>

	<section class="mb-4">
		<h2 class="h4">Our Community</h2>
		<p>
			We aim to build a welcoming marketplace based on accurate listings, respectful
			communication, responsible hosting, and thoughtful stays.
		</p>
	</section>

	<section>
		<h2 class="h4">Business Information</h2>
		<dl class="row mb-0">
			<dt class="col-sm-4">Business name</dt>
			<dd class="col-sm-8">Dwellr Pvt. Ltd.</dd>

			<dt class="col-sm-4">Owner</dt>
			<dd class="col-sm-8">Pulkit Sharma</dd>

			<dt class="col-sm-4">Platform</dt>
			<dd class="col-sm-8">Online accommodation marketplace</dd>

			<dt class="col-sm-4">Support</dt>
			<dd class="col-sm-8">Please use the contact details provided by Dwellr for your account or booking.</dd>
		</dl>
	</section>
</main>
