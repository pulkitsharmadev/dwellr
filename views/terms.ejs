<% layout("./layouts/boilerplate.ejs") %>

<main class="terms mx-auto my-5" style="max-width: 50rem;">
    <header class="mb-5">
        <p class="text-uppercase text-muted small fw-semibold mb-2">Dwellr</p>
        <h1 class="mb-3">Terms of Service</h1>
        <p class="lead text-muted mb-0">
            These terms explain the rules for using Dwellr as a guest or host.
